{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_ENV_FILE\" ] && printf 'export PATH=\"%s/bin:$PATH\"\\nexport REVIEW_GATE_CMD=review-gate\\n' \"$CLAUDE_PLUGIN_ROOT\" >> \"$CLAUDE_ENV_FILE\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/review-gate.js\" guard-tests",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/review-gate.js\" on-stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
