{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [ { "type": "command", "command": "npx --no-install review-gate guard-tests", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "npx --no-install review-gate on-stop", "timeout": 600 } ] }
    ]
  }
}
